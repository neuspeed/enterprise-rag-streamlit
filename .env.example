# Copy to .env and fill in. The worker validates this file at startup and names
# every missing variable at once, so a blank value here fails immediately rather
# than surfacing later as an empty knowledge base.
#
# Names must match know_everything_ai/settings.py exactly.

# ------------------------------------------------------------------ runtime
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true
DATA_DIR=./data

# ---------------------------------------------------------------- transport
# "rabbitmq" is the only transport with a worker shipped. "postgres" is a P1
# item; selecting it makes the process exit rather than idle.
INGEST_TRANSPORT=rabbitmq
MQ_HOST=rabbitmq
MQ_PORT=5672
MQ_USER=guest
MQ_PASS=guest
MQ_VIRTUAL_HOST=/

# Client name -> max concurrent messages. At least one entry is required: with
# none, the dispatcher declares no queues and consumes nothing while reporting
# itself as healthy.
CLIENT_WEIGHTS={"acme":4}

GLOBAL_CONCURRENCY=4
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60
MESSAGE_PROCESS_TIMEOUT_SECONDS=1800
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------- models
# All three roles talk the OpenAI chat-completions protocol, so any compatible
# gateway works: point *_API_URL at its /v1 and pass the same key twice.
#
# Ready-made profile for z.ai (https://docs.z.ai):
#   ENRICHER_API_URL   = https://api.z.ai/api/paas/v4
#   CLASSIFIER_API_URL = https://api.z.ai/api/paas/v4
#   VLM_API_URL        = https://api.z.ai/api/paas/v4
#   *_MODEL_NAME       = glm-5.3, except the VLM which must be glm-5.3-flash
# glm-5.3 is text-only and always answers with reasoning enabled; glm-5.3-flash
# is the multimodal one and accepts the base64 page images the PDF parser sends.
# Note the "coding plan" endpoint is api.z.ai/api/coding/paas/v4 — different host
# path, different quota. The plain model API above is the one meant for this.

# Small documents ("context" branch) go to the enricher.
ENRICHER_API_URL=
ENRICHER_API_KEY=
ENRICHER_MODEL_NAME=

# Large documents ("vector" branch) are chunked and classified here.
CLASSIFIER_API_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL_NAME=

# PDFs have no reliable text layer, so pages are rendered and read visually.
VLM_API_URL=
VLM_API_KEY=
VLM_MODEL_NAME=

# ----------------------------------------------------------------- fallbacks (optional)
# A second provider per role, used only when the primary fails transiently:
# 429, timeout, connection reset, 5xx. A 400 or 401 means this deployment is
# misconfigured, so it is raised immediately instead of being retried on another
# provider that would reproduce it.
#
# The usual fallback is a local Ollama: no quota and no per-token cost, so a
# rate-limited provider does not become a failed job.
#
# A model name requires the matching URL. Leaving the model set with no URL is
# rejected at startup rather than quietly never failing over. Leave both blank to
# run that role on its primary alone.
#
# To start one:
#   docker compose -f docker-compose.yml -f docker-compose.stand.yml up -d ollama
#   docker compose -f docker-compose.yml -f docker-compose.stand.yml \\
#     exec ollama ollama pull qwen3:1.7b
#
# Two things to know before pointing this at a small local model. It answers for
# the rest of a message once the primary has failed once, so quality drops
# mid-job, not just during an outage. And its context is far smaller than a
# hosted endpoint's, so MAX_CKB_TOKENS, PDF_MAX_PAGES_PER_REQUEST and
# PDF_RENDER_DPI have to fit it.
ENRICHER_FALLBACK_API_URL=
ENRICHER_FALLBACK_API_KEY=
ENRICHER_FALLBACK_MODEL_NAME=

CLASSIFIER_FALLBACK_API_URL=
CLASSIFIER_FALLBACK_API_KEY=
CLASSIFIER_FALLBACK_MODEL_NAME=

VLM_FALLBACK_API_URL=
VLM_FALLBACK_API_KEY=
VLM_FALLBACK_MODEL_NAME=

# Only the vector branch needs these; a context-only run can leave them blank.
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_CREDENTIAL=

# ------------------------------------------------------------------ Flowise
FLOWISE_ENABLED=false
FLOWISE_API_URL=
FLOWISE_API_KEY=
FLOWISE_TIMEOUT=60
FLOWISE_UPSERT_TIMEOUT=600

# ------------------------------------------------------------------- limits
MAX_UPLOAD_MB=100
MAX_FILES_PER_KB=50
MAX_DOCUMENTS_PER_KB=500

# Documents above this measured token count take the vector branch.
MAX_CKB_TOKENS=220000

TOKENIZER_BACKEND=auto
# Leave empty to use each model's own encoding.
TOKENIZER_ENCODING=

# --------------------------------------------------------------- source URLs
SOURCE_HTTP_TIMEOUT=60
SOURCE_MAX_REDIRECTS=5

# Leave off unless every source host is trusted: fetching arbitrary URLs is an
# SSRF vector, and the checks below are what stop file:// and the metadata
# endpoint from being read.
ALLOW_PRIVATE_URLS=false
# Off by default so an upload cannot read the worker's filesystem.
ALLOW_LOCAL_SOURCES=false

# Optional WebDAV mount for sources that need authentication.
WEBDAV_BASE_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=

# ------------------------------------------------------------------ query API
# Read-only retrieval endpoint (service `query_api` in compose, port 8000).
# It validates against the `api` role: no ENRICHER/CLASSIFIER/VLM settings and
# no broker credentials are needed for this process to start.
QUERY_API_HOST=0.0.0.0
QUERY_API_PORT=8000
# A request above the cap is clamped, not rejected.
QUERY_MAX_LIMIT=50
# Cosine floor for hit ranking; -1.0 disables the filter entirely.
QUERY_MIN_SCORE=-1.0
# How long a verified key stays cached in memory; revocation acts within this.
QUERY_API_KEY_CACHE_SECONDS=30

# ----------------------------------------------------------------------- chat
# The agent role that turns retrieved fragments into an answer. Fully optional:
# retrievals and /knowledge-bases/*/query work without it, and /chat earns a
# clear 503 until it is wired up.
#
# A cheap default is the same gateway as the extraction roles; any
# chat-completions endpoint works, including a local Ollama.
ANSWER_API_URL=
ANSWER_API_KEY=
ANSWER_MODEL_NAME=glm-5.3-flash
ANSWER_TIMEOUT=120
ANSWER_MAX_TOKENS=1200
ANSWER_TEMPERATURE=0.2
# How many fragments one answer may cite; also honoured by the SSE endpoint so a
# request cannot bloat the prompt past this budget.
ANSWER_MAX_FRAGMENTS=6

# Optional failover, same contract as the extraction roles: a model name
# requires the matching URL, and the URL requires a name.
ANSWER_FALLBACK_API_URL=
ANSWER_FALLBACK_API_KEY=
ANSWER_FALLBACK_MODEL_NAME=